<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.swctx.bench — launchd job running bench/nightly.sh at 03:30 daily:
  the cold-cwd MCP smoke plus the recall_mcp.py --ratchet gates.

  Install (files only — nothing here is loaded automatically):

      cp bench/com.swctx.bench.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.swctx.bench.plist

      # modern equivalent on current macOS:
      # launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.swctx.bench.plist

  IMPORTANT: ProgramArguments[1] is an ABSOLUTE path into this checkout —
  EDIT IT if the repo moves. StandardOutPath/StandardErrorPath are also
  absolute; adjust as needed (the script itself always logs gate failures
  to ~/.swctx/bench_failures.log).

  Unload:
      launchctl unload ~/Library/LaunchAgents/com.swctx.bench.plist
      # or: launchctl bootout gui/$(id -u)/com.swctx.bench
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swctx.bench</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/phuongnam/02.AI/NP_AI_macos/tools/swctx/bench/nightly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/com.swctx.bench.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.swctx.bench.err.log</string>
</dict>
</plist>
