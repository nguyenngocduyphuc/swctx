<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- com.swctx.bench: runs bench/nightly.sh at 03:30 daily (cold-cwd MCP smoke + recall ratchet).
     Install via: swctx watchd install writes its own plist; this one is installed manually:
     launchctl bootstrap gui/UID ~/Library/LaunchAgents/com.swctx.bench.plist
     NOTE: XML comments cannot contain double-hyphens; keep this comment free of them.
     ProgramArguments[1] is an ABSOLUTE path into this checkout; edit if the repo moves.
     Failures are logged to ~/.swctx/bench_failures.log. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swctx.bench</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/phuongnam/02.AI/NP_AI_macos/tools/swctx/bench/nightly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/com.swctx.bench.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.swctx.bench.err.log</string>
</dict>
</plist>
